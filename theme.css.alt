/* @settings

name: Tokyo Night Theme
id: tokyo-night-theme
settings:
    - id: tokyo-info
      title: Tokyo Night Theme — Color Settings
      description: "Настройка цветов темы. Все значения по умолчанию совпадают с оригинальной палитрой. Для светлой и тёмной темы — отдельные пикеры."
      type: info-text
      markdown: true

    - id: hd-backgrounds
      title: Backgrounds
      type: heading
      level: 2
      collapsed: false

    - id: background-primary
      title: Primary Background
      description: Main editor background
      type: variable-themed-color
      format: hex
      opacity: false
      default-light: '#e1e2e7'
      default-dark: '#1a1b26'

    - id: background-primary-alt
      title: Primary Background (Alternate)
      description: Code blocks, alternate surfaces
      type: variable-themed-color
      format: hex
      opacity: false
      default-light: '#d0d5e3'
      default-dark: '#1f2335'

    - id: background-secondary
      title: Secondary Background
      description: Sidebars, file explorer
      type: variable-themed-color
      format: hex
      opacity: false
      default-light: '#e9e9ed'
      default-dark: '#16161e'

    - id: background-modifier-border
      title: Borders
      type: variable-themed-color
      format: hex
      opacity: false
      default-light: '#c4c8da'
      default-dark: '#24283b'

    - id: hd-text
      title: Text
      type: heading
      level: 2
      collapsed: false

    - id: text-normal
      title: Normal Text
      type: variable-themed-color
      format: hex
      opacity: false
      default-light: '#3760bf'
      default-dark: '#c0caf5'

    - id: text-muted
      title: Muted Text
      type: variable-themed-color
      format: hex
      opacity: false
      default-light: '#6172b0'
      default-dark: '#a9b1d6'

    - id: text-faint
      title: Faint Text
      type: variable-themed-color
      format: hex
      opacity: false
      default-light: '#a8aecb'
      default-dark: '#565f89'

    - id: text-on-accent
